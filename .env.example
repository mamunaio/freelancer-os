# =====================================================================
#  Injaazh OS — environment template.
#  Copy to .env.local and fill in. Never commit .env.local.
# =====================================================================

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB?retryWrites=true&w=majority"
MONGODB_DB="injaazh_os"

# ─── Auth.js ─────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── Email — Resend ──────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# ─── File storage — Cloudflare R2 ────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ─── Exchange rates ──────────────────────────────────────────────────
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"
