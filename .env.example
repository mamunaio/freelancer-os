# Supabase — public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — service role key (server-only, never exposed to the browser)
# Used for privileged server actions and edge function helpers.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Exchange rate API (open.er-api.com — free, no key required)
# Override only if you switch providers.
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"
